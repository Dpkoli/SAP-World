# Copy this file to .env.local for local development.
# Never put real passwords, API keys, or production connection strings here.

# One-time bootstrap only. After the first owner exists, roles are managed in-app.
SAP_WORLD_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# Enterprise identity adapter: local-managed, oidc, or saml.
SAP_WORLD_IDENTITY_MODE=local-managed
SAP_WORLD_IDENTITY_PROVIDER=
SAP_WORLD_IDENTITY_ALLOWED_DOMAINS=
SAP_WORLD_OIDC_ISSUER=
SAP_WORLD_OIDC_CLIENT_ID=
SAP_WORLD_OIDC_CLIENT_SECRET=
SAP_WORLD_SAML_METADATA_URL=
SAP_WORLD_SAML_ENTITY_ID=
SAP_WORLD_SAML_CERTIFICATE=

# Optional recovery delivery webhook. Local development returns a reset token.
SAP_WORLD_PASSWORD_RESET_WEBHOOK_URL=
SAP_WORLD_PASSWORD_RESET_WEBHOOK_SECRET=

# Leave empty for local JSON storage. Set in hosted environments for PostgreSQL.
DATABASE_URL=

# Optional external mentor model. All three values are required to enable it.
SAP_WORLD_AI_ENDPOINT=
SAP_WORLD_AI_API_KEY=
SAP_WORLD_AI_MODEL=
SAP_WORLD_AI_TIMEOUT_MS=8000

# Optional hosted event export in addition to Vercel Analytics and Speed Insights.
SAP_WORLD_OBSERVABILITY_WEBHOOK_URL=
SAP_WORLD_OBSERVABILITY_WEBHOOK_SECRET=

# Optional promotion/rollback automation endpoint used by the admin control plane.
SAP_WORLD_RELEASE_PROVIDER=vercel
SAP_WORLD_RELEASE_AUTOMATION_URL=
SAP_WORLD_RELEASE_AUTOMATION_SECRET=
SAP_WORLD_PRODUCTION_URL=

# Local HTTP production testing only. Never enable this in a hosted deployment.
SAP_WORLD_INSECURE_COOKIES=false
